<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Luban.AlicizaX.Localization</AssemblyName>
  </PropertyGroup>
  <ItemGroup Condition="'$(LubanCoreProject)' != ''">
    <ProjectReference Include="$(LubanCoreProject)" />
  </ItemGroup>
  <ItemGroup Condition="'$(LubanCoreProject)' == ''">
    <Reference Include="Luban.Core">
      <HintPath>$(LubanCorePath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
