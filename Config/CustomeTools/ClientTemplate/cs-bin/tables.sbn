        public void TranslateText()
        {
            if (!_isLoaded)
            {
                return;
            }

            string Translator(string key)
            {
                string value = key;
                PostTranslateText(key, ref value);
                return value;
            }
            {{~for table in __tables ~}}
            {{format_property_name __code_style table.name}}.TranslateText(Translator);
            {{~end~}}
        }

        private void EnsureLoader()
        {
            if (_loader == null)
            {
                throw new InvalidOperationException("ConfigService is not initialized. Call Initialize(loader) first.");
            }
        }

